{
  "//": "CI-only settings for headless Claude Code CLI invocations. Passed via --settings. Mirrors forbidden-paths.txt - keep them in sync. This is the PROACTIVE guardrail layer; ci/ai-pipeline/lib/guardrails.sh is the REACTIVE layer that re-checks on the host regardless of this file.",
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "Edit(Jenkinsfile)",
      "Write(Jenkinsfile)",
      "Edit(ci/**)",
      "Write(ci/**)",
      "Edit(podman/**)",
      "Write(podman/**)",
      "Edit(.github/workflows/**)",
      "Write(.github/workflows/**)",
      "Edit(**/.env)",
      "Write(**/.env)",
      "Edit(**/.env.*)",
      "Write(**/.env.*)",
      "Edit(**/*secret*)",
      "Write(**/*secret*)",
      "Edit(**/*credential*)",
      "Write(**/*credential*)",
      "Edit(**/*.pem)",
      "Write(**/*.pem)",
      "Edit(**/*.key)",
      "Write(**/*.key)",
      "Edit(k8s/**)",
      "Write(k8s/**)",
      "Edit(deploy/**)",
      "Write(deploy/**)",
      "Edit(infra/**)",
      "Write(infra/**)",
      "Edit(terraform/**)",
      "Write(terraform/**)",
      "Edit(docker-compose*.yml)",
      "Write(docker-compose*.yml)",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git reset:*)",
      "Bash(git branch:*)",
      "Bash(gh:*)"
    ]
  }
}
